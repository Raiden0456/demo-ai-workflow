{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet run --project tools/Demo.JiraMock:*)",
      "Bash(dotnet test:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "mcp__jira__get_active_sprint",
      "mcp__jira__get_issue",
      "mcp__jira__search_issues",
      "mcp__notion__get_page",
      "mcp__notion__search_pages"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(dotnet add:*)",
      "Bash(gh api:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git switch:*)",
      "Bash(wget:*)",
      "WebFetch",
      "mcp__jira__create_issue",
      "mcp__notion__append_to_page",
      "mcp__notion__create_page"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/appsettings.*.local.json)",
      "Read(./secrets/**)",
      "Edit(./.claude/settings.json)",
      "Bash(gh pr review:*)",
      "Bash(rm -rf:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "enabledMcpjsonServers": [
    "jira",
    "notion"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-cs.sh"
          }
        ]
      }
    ]
  }
}
